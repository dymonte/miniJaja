<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>
<?import org.fxmisc.richtext.CodeArea?>

<SplitPane dividerPositions="0.75"
          orientation="VERTICAL"
          prefHeight="200.0" prefWidth="160.0"
          xmlns="http://javafx.com/javafx/21.0.8"
          xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="org.groupe2.projetVMs.controller.CodeSectionController">
    <items>
        <StackPane>
            <CodeArea fx:id="codeArea" 
                     styleClass="code-area"
                     wrapText="true"
                     prefWidth="200.0" 
                     prefHeight="200.0"/>
        </StackPane>
        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="265.0" prefWidth="280.0">
            <children>
                <Label alignment="CENTER" minWidth="60.0" prefWidth="-1.0" style="&#10;" text="Execution" textAlignment="CENTER" wrapText="false">
                    <font>
                              <Font size="18.0" fx:id="x11" />
                           </font>
                           <textFill>
                              <Color red="0.624" green="0.624" blue="0.624" fx:id="x21" />
                           </textFill>
                        </Label>
                     </children></AnchorPane>
              </items>
            </SplitPane>
