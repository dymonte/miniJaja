<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="fr.umlp.m1info.projectvms.group2.controller.FileTreeSectionController" fillWidth="true" maxWidth="Infinity" maxHeight="Infinity" VBox.vgrow="ALWAYS">
	<StackPane>
		<Label fx:id="headerLabel" text="EXPLORER" StackPane.alignment="CENTER_LEFT"/>
	</StackPane>
	<ScrollPane fx:id="fileTreeScroll" fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
		<VBox fx:id="fileTreeContainer" fillWidth="true" maxWidth="Infinity" maxHeight="Infinity" VBox.vgrow="ALWAYS"/>
	</ScrollPane>
</VBox>
