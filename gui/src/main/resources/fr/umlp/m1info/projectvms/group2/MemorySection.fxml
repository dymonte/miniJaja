<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="fr.umlp.m1info.projectvms.group2.controller.MemorySectionController">

  <children>
    <Label alignment="CENTER"
            layoutX="14.0" layoutY="14.0"
            text="Memory"
            textAlignment="CENTER">
      <font>
        <Font size="18.0" />
      </font>
    </Label>

    <VBox spacing="5.0" AnchorPane.topAnchor="50" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0">
      <TextArea fx:id="memoryStackTextArea"
              editable="false"
              wrapText="false"
              VBox.vgrow="ALWAYS"
      />

      <TextArea fx:id="memoryHeapTextArea"
              editable="false"
              wrapText="false"
              VBox.vgrow="ALWAYS"
      />

    </VBox>
  </children>
</AnchorPane>
