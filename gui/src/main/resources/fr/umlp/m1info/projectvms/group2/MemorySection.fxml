<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="fr.umlp.m1info.projectvms.group2.controller.MemorySectionController"
            prefHeight="550.0" prefWidth="150.0"
            minWidth="150.0" maxWidth="150.0">

  <children>
    <Label alignment="CENTER"
            layoutX="14.0" layoutY="14.0"
            text="Memory"
            textAlignment="CENTER">
      <font>
        <Font size="18.0" />
      </font>
    </Label>

    <TextArea fx:id="memoryTextArea"
            layoutX="0.0" layoutY="50.0"
